@startuml
!theme spacelab

entity "person" as person {
  *id : INT
  document_type : VARCHAR(10)
  document_number : VARCHAR(30)
  first_name : VARCHAR(100)
  last_name : VARCHAR(100)
  phone : VARCHAR(20)
  email : VARCHAR(100)
  address : VARCHAR(150)
  registration_date : TIMESTAMP
}

entity "role" as role {
  *id : INT
  role_name : VARCHAR(50)
  description : TEXT
}

entity "user_account" as user_account {
  *id : INT
  username : VARCHAR(50)
  password : VARCHAR(255)
  status : BOOLEAN
  person_id : INT
  role_id : INT
}

entity "company" as company {
  *id : INT
  company_name : VARCHAR(150)
  tax_id : VARCHAR(30)
  phone : VARCHAR(20)
  email : VARCHAR(100)
  address : VARCHAR(150)
}

entity "category" as category {
  *id : INT
  category_name : VARCHAR(100)
  description : TEXT
}

entity "product" as product {
  *id : INT
  product_name : VARCHAR(100)
  description : TEXT
  unit_price : NUMERIC(12,2)
  category_id : INT
}

entity "inventory" as inventory {
  *id : INT
  product_id : INT
  supplier_id : INT
  current_stock : INT
  last_update : TIMESTAMP
}

entity "invoice" as invoice {
  *id : INT
  invoice_number : VARCHAR(50)
  issue_date : DATE
  client_id : INT
  user_account_id : INT
  total : NUMERIC(14,2)
}

entity "invoice_detail" as invoice_detail {
  *id : INT
  invoice_id : INT
  product_id : INT
  quantity : INT
  unit_price : NUMERIC(12,2)
  subtotal : NUMERIC(14,2)
}

entity "branch" as branch {
  *id : INT
  branch_name : VARCHAR(100)
  address : VARCHAR(150)
  phone : VARCHAR(20)
  company_id : INT
}

entity "client" as client {
  *id : INT
  person_id : INT
  client_code : VARCHAR(20)
  registration_date : TIMESTAMP
}

person --{ user_account : person_id
role --{ user_account : role_id
category --{ product : category_id
product --{ inventory : product_id
company --{ inventory : supplier_id
client --{ invoice : client_id
user_account --{ invoice : user_account_id
invoice --{ invoice_detail : invoice_id
product --{ invoice_detail : product_id
company --{ branch : company_id
person --{ client : person_id

@enduml